# ════════════════════════════════════════════════════════════
#  MenuCam V3 — Variables d'environnement
#  ► Copiez ce fichier en .env pour le développement local
#  ► Sur Railway : ajoutez ces variables dans le dashboard
# ════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# URL publique de votre app (récupérez-la après déploiement Railway)
APP_URL=https://votre-app.up.railway.app

# ── Sécurité ────────────────────────────────────────────────
# Générez avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changez_ceci_avec_une_cle_tres_longue_et_aleatoire

# ── Base de données ─────────────────────────────────────────
# ★ RECOMMANDÉ : MongoDB Atlas (gratuit 512MB — données persistantes)
# Obtenez votre URI sur : https://mongodb.com/atlas
# Format : mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/menucam
MONGODB_URI=mongodb+srv://menucam:VOTRE_PASSWORD@cluster0.xxxxx.mongodb.net/menucam
MONGODB_DB=menucam

# Si MONGODB_URI est absent → NeDB local (données perdues au redéploiement Railway)
# DB_PATH=./data  ← développement local uniquement

# ── Uploads (images plats) ──────────────────────────────────
# Sur Railway : fichiers locaux éphémères → préférez Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Délai annulation commande (minutes) ─────────────────────
DELAI_ANNULATION_MIN=5

# ── CinetPay (MTN, Orange, Wave, Moov — Afrique) ────────────
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ── MTN Mobile Money ─────────────────────────────────────────
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_ENV=sandbox

# ── Orange Money ─────────────────────────────────────────────
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
